{
  "note": "Every gate in the CI validation chain must hard-fail when its input set is empty. A validator that passes while examining zero items is not passing. scripts/validate_zero_item_guards.js proves this by running each one against the probe named here and requiring a non-zero exit; a CI-chain validator with no entry here is itself a hard failure, so the rule cannot be escaped by adding a new gate.",
  "origin": "Run 33889515936 (2026-09-04) went red because validate:workflow-liveness refused to exit 0 without the credential its live check needs. It was the only gate in the suite that had that check written by hand. An audit found six siblings that printed a zero count next to the word PASS.",
  "chain_roots": [
    "validate:all",
    "validate:governance",
    "validate:autonomous",
    "validate:workflow-liveness",
    "validate:workflow-data-trace",
    "validate:workflow-faux-trace",
    "actions:validate"
  ],
  "probes": {
    "html-corpus": {
      "description": "Every published .html page removed. This is the input set of every gate that walks the site corpus; it exists only because an earlier build stage produced it, so a skipped or reordered stage empties it silently.",
      "delete_files_with_extension": [
        ".html"
      ]
    },
    "content-insights": {
      "description": "content/insights emptied. The published-insight markdown is the list every duplicate-body, routing and parity check in validate_insights iterates.",
      "empty_dir_contents": [
        "content/insights"
      ]
    },
    "workflow-files": {
      "description": ".github/workflows emptied. This is the exact 2026-06-25 condition that started this whole line of work: a workflow file deleted in a sync commit, with nothing red to show for it.",
      "empty_dir_contents": [
        ".github/workflows"
      ]
    },
    "data-records": {
      "description": "data/ emptied. The demand records, atoms, page families, atlas units, cadence policy and authority-scale inputs all live here; a gate that reads none of them is asserting nothing.",
      "empty_dir_contents": [
        "data"
      ]
    },
    "validator-registry": {
      "description": "_validator_registry.json validators[] emptied. The registry IS the input set of the registry gate.",
      "empty_json_array": [
        {
          "file": "_validator_registry.json",
          "key": "validators"
        }
      ]
    },
    "release-producers": {
      "description": "Every script that writes the quality_rejected counter removed, so the vocabulary gate finds zero producers bound to the registry it governs.",
      "delete_paths": [
        "scripts/release/self_heal_release_quality.js",
        "scripts/citation_intelligence/apply_release_plan.js",
        "scripts/citation_intelligence/build_release_plan.js"
      ]
    },
    "release-plan": {
      "description": "releases/citation_release_plan.json truncated to an empty release_units[] with every other key stripped - the shape a crashed or half-written planner leaves behind. It still parses, so the gate runs; it must not read the absence of a budget as a declared budget of zero.",
      "truncate_json_to": [
        {
          "file": "releases/citation_release_plan.json",
          "keep": [
            "release_units"
          ]
        }
      ]
    },
    "self": {
      "description": "This guard's own contract emptied of validators[]. It is subject to the rule it enforces: with nothing to probe it must refuse to exit 0, not report that every validator passed.",
      "empty_json_array": [
        {
          "file": "_zero_item_guard_contract.json",
          "key": "validators"
        }
      ]
    },
    "site-head-assets": {
      "description": "The site-head asset files removed: favicon.ico, apple-touch-icon.png, site.webmanifest and indexnow.txt. They are the input set of the icon and IndexNow gates.",
      "delete_paths": [
        "favicon.ico",
        "apple-touch-icon.png",
        "site.webmanifest",
        "indexnow.txt"
      ]
    },
    "measured-404-rules": {
      "description": "data/redirects/measured_404_redirects.json rules[] emptied. Those rules are the 301s for URLs Search Console measured that would otherwise 404 (149 on 11 Oct 2026); a gate that checks none of them proves nothing.",
      "empty_json_array": [
        {
          "file": "data/redirects/measured_404_redirects.json",
          "key": "rules"
        }
      ]
    },
    "demand-families": {
      "description": "data/seo/demand_families.json families[] emptied. The families are what the strengthening sweep and the top-12 demand pages are chosen from (482 measured queries on 11 Oct 2026); a gate that checks none proves nothing.",
      "empty_json_array": [
        {
          "file": "data/seo/demand_families.json",
          "key": "families"
        }
      ]
    },
    "demand-pages": {
      "description": "data/seo/demand_pages.json pages[] emptied. Those are the pages serving the top-12 query families; a gate that checks none proves nothing.",
      "empty_json_array": [
        {
          "file": "data/seo/demand_pages.json",
          "key": "pages"
        }
      ]
    },
    "sitemap-file": {
      "description": "sitemap.xml removed. The <lastmod> dates in that one file are the entire input set of the lastmod-honesty gate: with no sitemap there are no dates to find dishonest, which is exactly the shape of a gate that passes having looked at nothing.",
      "delete_paths": [
        "sitemap.xml"
      ]
    }
  },
